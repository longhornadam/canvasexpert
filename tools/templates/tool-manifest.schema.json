{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CanvasExpert Tool Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "status",
    "purpose",
    "use_when",
    "avoid_when",
    "inputs",
    "outputs",
    "command",
    "source_of_truth",
    "notes"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["available", "planned", "experimental"]
    },
    "purpose": {
      "type": "string"
    },
    "use_when": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "avoid_when": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "object"
    },
    "outputs": {
      "type": "object"
    },
    "command": {
      "type": ["string", "null"]
    },
    "source_of_truth": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
