{% extends "base.html.j2" %}
{% block content %}
<p class="name-line">Name: ________________________________________________</p>
<h1>{{ printdoc.title }}</h1>
{% if printdoc.instructions %}
<section class="instructions">
  {{ printdoc.instructions | safe }}
</section>
{% endif %}

{% for block in printdoc.blocks %}
  {% if block.__class__.__name__ == "Stimulus" %}
    <section class="stimulus stimulus-{{ block.fmt }}">
      {% if block.title %}<p class="stimulus-title">{{ block.title }}</p>{% endif %}
      {% if block.author %}<p class="stimulus-author">{{ block.author }}</p>{% endif %}
      {% if block.fmt == "code" %}
        <pre class="stimulus-code">{{ block.body_html }}</pre>
      {% elif block.fmt == "poetry" %}
        <table class="poetry-table">
          <tbody>
          {% for line in block.body_html | poetry_lines %}
            {% if line.blank %}
            <tr class="poetry-gap"><td></td><td>&nbsp;</td></tr>
            {% else %}
            <tr>
              <td class="poetry-number">{% if line.number %}{{ line.number }}{% endif %}</td>
              <td class="poetry-line">{{ line.text }}</td>
            </tr>
            {% endif %}
          {% endfor %}
          </tbody>
        </table>
      {% else %}
        <div class="stimulus-body">
          {% for prose in block.body_html | prose_blocks %}
            <div class="stimulus-prose">{{ prose | safe }}</div>
          {% endfor %}
        </div>
      {% endif %}
    </section>
  {% else %}
    <section class="question question-{{ block.qtype | lower }}">
      {% if block.qtype == "TF" %}<p class="question-label">(True/False)</p>{% endif %}
      <p class="question-prompt"><strong>{{ block.number }}.</strong> {{ block.prompt_html | safe }}</p>

      {% if block.qtype in ["MC", "MA"] %}
        {% if block.payload.two_column %}
          <table class="choice-table two-column">
            <tbody>
            {% for row in block.payload.choices | batch(2, none) %}
              <tr>
              {% for choice in row %}
                <td>{% if choice %}<strong>{{ choice.letter }}.</strong> {{ choice.html | safe }}{% endif %}</td>
              {% endfor %}
              </tr>
            {% endfor %}
            </tbody>
          </table>
        {% else %}
          <ol class="choices" type="A">
          {% for choice in block.payload.choices %}
            <li value="{{ loop.index }}">{{ choice.html | safe }}</li>
          {% endfor %}
          </ol>
        {% endif %}
      {% elif block.qtype == "TF" %}
        <p class="tf-options">A. True&nbsp;&nbsp;&nbsp;&nbsp;B. False</p>
      {% elif block.qtype == "MATCHING" %}
        <table class="matching-table">
          <tbody>
          {% for pair in block.payload.pairs %}
            <tr>
              <td class="blank">_____</td>
              <td>{{ pair.answer }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
        <ol class="matching-legend" type="A">
        {% for pair in block.payload.pairs %}
          <li value="{{ loop.index }}">{{ pair.prompt }}</li>
        {% endfor %}
        </ol>
      {% elif block.qtype == "ORDERING" %}
        <table class="blank-table">
          <tbody>
          {% for item in block.payload.items %}
            <tr><td class="blank">_____</td><td>{{ item }}</td></tr>
          {% endfor %}
          </tbody>
        </table>
      {% elif block.qtype == "CATEGORIZATION" %}
        {% if block.payload.categories %}
          <p class="category-list"><strong>Categories:</strong> {{ block.payload.categories | join(", ") }}</p>
        {% endif %}
        <p class="paper-instruction">Write the correct category in the blank next to each item.</p>
        <table class="blank-table">
          <tbody>
          {% for item in block.payload.items %}
            <tr><td class="blank">_____</td><td>{{ item }}</td></tr>
          {% endfor %}
          </tbody>
        </table>
      {% elif block.qtype in ["NUMERICAL", "ESSAY"] %}
        <p class="answer-line">Answer: ______________________________</p>
      {% endif %}
    </section>
  {% endif %}
{% endfor %}
{% endblock %}
