{% extends "base.html.j2" %}
{% block content %}
<h1>{{ printdoc.title }} - Answer Key</h1>
{% if printdoc.answer_key and printdoc.answer_key.rows %}
<table class="answer-key">
  <thead>
    <tr>
      <th>Question #</th>
      <th>Correct Answer</th>
      <th>Points</th>
    </tr>
  </thead>
  <tbody>
  {% for row in printdoc.answer_key.rows %}
    <tr>
      <td>{{ row.number }}</td>
      <td>{{ row.answer }}</td>
      <td>{{ row.points }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
<p class="total-points"><strong>Total Points:</strong> {{ printdoc.answer_key.total }}</p>
{% endif %}
{% endblock %}
